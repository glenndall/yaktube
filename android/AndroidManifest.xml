<?xml version="1.0" encoding="utf-8"?>
<!-- YakTube TV: a full-screen window onto your YakTube server (Google TV, Android TV, Fire TV). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="yaktube.tv">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- usesCleartextTraffic: a YakTube server on the home network is usually plain http:// -->
    <application android:label="YakTube" android:usesCleartextTraffic="true"android:icon="@drawable/icon" android:banner="@drawable/banner"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen" android:hardwareAccelerated="true">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
